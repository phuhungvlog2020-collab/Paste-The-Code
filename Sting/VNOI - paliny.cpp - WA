   cout << getH(1, 3, h1) << " " << getH(3, 5, h1) << endl; 
    int l = 1, r = n / 2, res1 = -1, res2 = 1;
    while(l <= r){
        int m = (l + r) / 2;
        if(check1(m)){
            l = m + 1;
            res1 = 2 * m;
        } else{
            r = m - 1;
