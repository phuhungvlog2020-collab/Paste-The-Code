//Const 󰏿
const int N = 6e5 + 5, mod = 1e9 + 7, INF = 2e18 + 5, base = 311, base2 = 367, mod2 = 1e9 + 9;
//Global Array 󰅠 󰅪
int n;
string s;
int h1[N], h2[N], Pow1[N], Pow2[N];
