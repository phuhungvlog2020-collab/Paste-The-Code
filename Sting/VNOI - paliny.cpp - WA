//Gobal Variable 󰅠 󰆧 
//Function 󰊕
void prepare(){ 
    Pow1[0] = 1; Pow2[n + 1] = 1;
    for(int i = 1; i <= n; i++) Pow1[i] = (Pow1[i - 1] * base) % mod;
    for(int i = 1; i <= n; i++) h1[i] = ((h1[i - 1] * base) % mod + s[i] - 'A' + 1) % mod;
    for(int i = n; i >= 1; i--) h2[n - i + 1] = ((h2[n - i] * base) % mod + s[i] - 'A' + 1) % mod;
}
int getH(int l, int r, const int *h1){
    return ((h1[r] - h1[l - 1]) * Pow1[r - l + 1] + mod * mod) % mod;
}
bool check1(int x){
    for(int i = 1; i + 2 * x - 1 <= n; i++){
        // cout << i << " " <<  i + 2 * x - 1 << " " << n - i + 2 - 2 * x << " " << n - i + 1 << endl;
        if(getH(i, i + 2 * x - 1, h1) == getH(n - i - 2 * x + 2, n - i + 1, h2)){
            return true;
        }
    }
    return false;
}
bool check2(int x){
    for(int i = 1; i + 2 * x <= n; i++){

        cout << i << " " << x << " " << getH(i, i + 2 * x, h1) << " " << getH(n - i + 1 - 2 * x, n - i + 1, h2) << endl;
        cout << i << " " <<  i + 2 * x << " " << n - i + 1 - 2 * x << " " << n - i + 1 << endl;
        if(getH(i, i + 2 * x, h1) == getH(n - i + 1 - 2 * x, n - i + 1, h2)){
            return true;
        }
    }
    return false;
}
//↓ Include solution here ↓
void solve(int tc){
    cin >> n;
